# Database
DATABASE_URL="postgresql://user:password@host:5432/kitflow"

# Server
PORT=3000
NODE_ENV=production
FRONTEND_URL=*

# API Security
API_SECRET=seu-segredo-aqui-troque-por-algo-seguro

# Correios API Rastro Empresarial
CORREIOS_USUARIO=seu-usuario-correios
CORREIOS_SENHA=sua-senha-correios
CORREIOS_CONTRATO=numero-do-contrato
CORREIOS_CARTAO=numero-do-cartao-postagem

# Z-API WhatsApp
ZAPI_INSTANCE_ID=sua-instance-id
ZAPI_TOKEN=seu-token-zapi
ZAPI_CLIENT_TOKEN=seu-client-token
ZAPI_BASE_URL=

# Job settings
TRACKING_INTERVAL_MINUTES=60
POST1_DAYS_AFTER_DELIVERY=7
POST2_DAYS_AFTER_DELIVERY=14
