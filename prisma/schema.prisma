generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Influencer {
  id             String         @id @default(cuid())
  // Dados pessoais
  nome           String
  handle         String         @unique
  email          String?
  whatsapp       String?
  instagram      String?
  // Endereço
  logradouro     String?
  numero         String?
  complemento    String?
  bairro         String?
  cidade         String?
  estado         String?
  cep            String?
  // Métricas
  seguidores     Int            @default(0)
  engajamento    Float          @default(0)
  avgLikes       Int?
  avgComments    Int?
  postsWeek      Int?
  storiesDay     Int?
  reelsMonth     Int?
  tiktokFollowers Int?
  youtubeFollowers Int?
  femaleAudience Float?
  ageRange       String?
  bestTime       String?
  nicho          String?
  // Kit
  kitStatus      KitStatus      @default(PREPARANDO)
  trackingCode   String?
  sentDate       DateTime?
  deliveryDate   DateTime?
  post1Date      DateTime?
  post2Date      DateTime?
  post1Done      Boolean        @default(false)
  post2Done      Boolean        @default(false)
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  trackingEvents TrackingEvent[]
  messageLogs    MessageLog[]
}

model TrackingEvent {
  id           String     @id @default(cuid())
  influencerId String
  influencer   Influencer @relation(fields:[influencerId], references:[id], onDelete:Cascade)
  codigo       String
  descricao    String
  local        String?
  dtHrCriado   String?
  rawStatus    String?
  createdAt    DateTime   @default(now())
}

model MessageLog {
  id           String      @id @default(cuid())
  influencerId String
  influencer   Influencer  @relation(fields:[influencerId], references:[id], onDelete:Cascade)
  messageType  MessageType
  sendStatus   SendStatus  @default(PENDING)
  phoneNumber  String?
  message      String?
  errorMsg     String?
  sentAt       DateTime?
  createdAt    DateTime    @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  text      String
  color     String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model SystemLog {
  id        String   @id @default(cuid())
  level     String
  job       String?
  message   String
  createdAt DateTime @default(now())
}

enum KitStatus {
  PREPARANDO
  ENVIADO
  TRANSITO
  ENTREGUE
  POST1_PENDENTE
  POST2_PENDENTE
  CONCLUIDO
}

enum MessageType {
  KIT_ENVIADO
  EM_TRANSITO
  KIT_ENTREGUE
  COBRAR_POST1
  COBRAR_POST2
  CUSTOM
}

enum SendStatus {
  PENDING
  SENT
  FAILED
}
